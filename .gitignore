# MkDocs build output — generated, never committed (CI rebuilds it).
site/

# Material "social" plugin render cache — regenerated per build, never committed.
# (The generated card PNGs themselves live under site/assets/images/social, already
# covered by the site/ rule above.)
.cache/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Screenshot tooling (Playwright) — local installs and auth artifacts.
tooling/screenshots/node_modules/
tooling/screenshots/playwright/.auth/
tooling/screenshots/test-results/

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/
